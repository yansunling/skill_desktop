{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "技能管理器",
    "version": "0.1.2"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": ["msi", "updater"],
      "identifier": "com.codex.skill-manager",
      "icon": ["icons/icon.ico"],
      "windows": {
        "wix": {
          "language": "zh-CN"
        }
      }
    },
    "allowlist": {
      "all": false,
      "dialog": {
        "open": true
      },
      "fs": {
        "all": true
      },
      "path": {
        "all": true
      },
      "process": {
        "relaunch": true
      }
    },
    "windows": [
      {
        "title": "技能管理器",
        "width": 1280,
        "height": 820,
        "resizable": true
      }
    ],
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0RkQ5MTcxRjlBRUM0OTkKUldTWnhLNzVjWkg5UkxvUnc0ZDNLOGtucFNDREYyeWFkazk1NVBWWVBVb2s5R2JOanpmRUVOSmYK",
      "endpoints": [
        "https://github.com/yansunling/skill_desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
